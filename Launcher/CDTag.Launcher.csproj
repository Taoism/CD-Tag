<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cdtag.exe at the top of a Release build. Built on .NET Framework 4.8 (part of Windows 10/11), it starts the
    real CD-Tag in bin\ and, when the .NET 10 Desktop Runtime is missing, installs it first.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <AssemblyName>cdtag</AssemblyName>
    <RootNamespace>CDTag.Launcher</RootNamespace>
    <ApplicationIcon>..\CDTag\cdtag.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
