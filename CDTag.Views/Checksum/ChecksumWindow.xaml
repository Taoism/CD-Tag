<Views:WindowViewBase
    x:Class="CDTag.Views.Checksum.ChecksumWindow"
    x:Name="checksumWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    Title="Create/Verify Checksum"
    Width="780"
    Height="540"
    MinWidth="560"
    MinHeight="360"
    WindowStartupLocation="CenterOwner"
>
    <Window.Resources>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Bad">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusBad}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusBad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Extra">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusWarning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="HashCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folder -->
        <Grid Grid.Row="0" IsEnabled="{Binding IsBusy, Converter={StaticResource NegateBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="2" Content="_Browse..." Command="{Binding BrowseCommand}" Padding="10,2" Margin="6,0,0,0" />
        </Grid>

        <!-- Mode -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource NegateBoolConverter}}">
            <RadioButton Content="_Create a checksum file" GroupName="Mode" IsChecked="{Binding IsCreateMode, Mode=TwoWay}" Margin="0,0,20,0" />
            <RadioButton Content="_Verify a checksum file" GroupName="Mode" IsChecked="{Binding IsVerifyMode, Mode=TwoWay}" />
        </StackPanel>

        <!-- Options for the mode -->
        <Grid Grid.Row="2" Margin="0,10,0,8" IsEnabled="{Binding IsBusy, Converter={StaticResource NegateBoolConverter}}">
            <!-- Create -->
            <Grid Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="File name:" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding OutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="_Audio files only" IsChecked="{Binding AudioOnly, Mode=TwoWay}" Margin="0,0,20,0" />
                    <CheckBox Content="Include _subfolders" IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
            <!-- Verify -->
            <Grid Visibility="{Binding IsVerifyMode, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Checksum file:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ChecksumFiles}" SelectedItem="{Binding SelectedChecksumFile, Mode=TwoWay}" />
            </Grid>
        </Grid>

        <!-- Files -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="3*" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='{}{0:#,0}'}" Width="95" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Checksum" Binding="{Binding Hash}" Width="2*" ElementStyle="{StaticResource HashCell}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" ElementStyle="{StaticResource StatusCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Progress -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusText}" />
            <ProgressBar Grid.Column="1" Height="12" Margin="8,0,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="C_reate" Command="{Binding CreateCommand}" MinWidth="80" Padding="7,2" IsDefault="True"
                    Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="_Verify" Command="{Binding VerifyCommand}" MinWidth="80" Padding="7,2" IsDefault="True"
                    Visibility="{Binding IsVerifyMode, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="S_top" Command="{Binding CancelCommand}" MinWidth="80" Padding="7,2" Margin="8,0,0,0" />
            <Button Content="_Close" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="80" Padding="7,2" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Views:WindowViewBase>
