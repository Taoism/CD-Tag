<Views:WindowViewBase
    x:Class="CDTag.Views.Options.OptionsWindow"
    x:Name="optionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    Title="Options"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
>
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="12,0,0,14" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="19,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Appearance -->
        <TextBlock Grid.Row="0" Text="Appearance" Style="{StaticResource SectionHeader}" />
        <StackPanel Grid.Row="1" Style="{StaticResource SectionBody}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Label Content="_Theme:" Target="{Binding ElementName=ThemeComboBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay}">
                    <ComboBoxItem Content="Use Windows setting" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Startup -->
        <TextBlock Grid.Row="2" Text="When CD-Tag starts, open" Style="{StaticResource SectionHeader}" />
        <StackPanel Grid.Row="3" Style="{StaticResource SectionBody}">
            <RadioButton Content="The _last folder used" GroupName="Startup" IsChecked="{Binding IsStartupLastUsed, Mode=TwoWay}" Margin="0,0,0,6" />
            <RadioButton x:Name="StartupSpecificRadio" Content="_This folder:" GroupName="Startup" IsChecked="{Binding IsStartupSpecific, Mode=TwoWay}" />
            <Grid Margin="19,4,0,0" IsEnabled="{Binding IsChecked, ElementName=StartupSpecificRadio}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding StartupFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2,1" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="_Browse..." Command="{Binding BrowseStartupFolderCommand}" Padding="10,2" Margin="6,0,0,0" />
            </Grid>
        </StackPanel>

        <!-- File browser -->
        <TextBlock Grid.Row="4" Text="File browser" Style="{StaticResource SectionHeader}" />
        <StackPanel Grid.Row="5">
            <StackPanel Style="{StaticResource SectionBody}">
                <CheckBox Content="Show _hidden files and folders" IsChecked="{Binding ShowHiddenFiles, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource Hint}" Text="Protected operating system items stay hidden." />
            </StackPanel>

            <!-- Tagging -->
            <TextBlock Text="Tagging" Style="{StaticResource SectionHeader}" />
            <StackPanel Style="{StaticResource SectionBody}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Label Content="New ID3v2 tags use _version:" Target="{Binding ElementName=ID3v2VersionComboBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ID3v2VersionComboBox" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding NewTagID3v2Version, Mode=TwoWay}">
                        <ComboBoxItem Content="ID3v2.3 (most compatible)" Tag="ID3v23" />
                        <ComboBoxItem Content="ID3v2.4" Tag="ID3v24" />
                    </ComboBox>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Used when a file has no ID3v2 tag yet. Existing tags keep their version." />
                <CheckBox Content="Tag the _FLAC and MP3 albums together" IsChecked="{Binding TagBothFormats, Mode=TwoWay}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="When the same rip is in a folder next to the album in the other format (same discs, tracks and lengths), Finish tags both: the same tags and release information, each with its own profile. Finish asks whether the NFO notes are different for the second release." />
                <CheckBox Content="_Keep the rip logs (.log) when finishing" IsChecked="{Binding KeepRipLogs, Mode=TwoWay}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off: Finish deletes the rip logs in the album folder (EAC / XLD .log files and auCDtect reports). On: they are kept and named like the profile names logs." />
            </StackPanel>

            <!-- Encoders -->
            <TextBlock Text="Encoders" Style="{StaticResource SectionHeader}" />
            <StackPanel Style="{StaticResource SectionBody}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_LAME:" Target="{Binding ElementName=LamePathBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="LamePathBox" Grid.Column="1" Text="{Binding LamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2,1" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseLameCommand}" Padding="10,2" Margin="6,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,6" Text="{Binding LameInfo}" />
                    <Label Grid.Row="2" Content="_FLAC:" Target="{Binding ElementName=FlacPathBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="FlacPathBox" Grid.Row="2" Grid.Column="1" Text="{Binding FlacPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2,1" VerticalContentAlignment="Center" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseFlacCommand}" Padding="10,2" Margin="6,0,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding FlacInfo}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Leave empty to use the built-in LAME 3.100 and FLAC 1.5.0. To use another version, put lame.exe in Encoders\mp3 or flac.exe in Encoders\flac next to cdtag.exe." />
            </StackPanel>

            <!-- CD lookup -->
            <TextBlock Text="CD lookup (Rip)" Style="{StaticResource SectionHeader}" />
            <StackPanel Style="{StaticResource SectionBody}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="_gnudb address:" Target="{Binding ElementName=GnudbBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="GnudbBox" Grid.Column="1" Text="{Binding GnudbEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2,1" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="gnudb.org (the freedb successor) only answers registered programs: enter the e-mail address you registered with gnudb to also look discs up there. MusicBrainz and CUETools DB need nothing." />
            </StackPanel>

            <!-- Discogs -->
            <TextBlock Text="Discogs (Look up)" Style="{StaticResource SectionHeader}" />
            <StackPanel Style="{StaticResource SectionBody}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Content="_Personal access token:" Target="{Binding ElementName=DiscogsTokenBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="DiscogsTokenBox" Grid.Column="1" Text="{Binding DiscogsToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2,1" />
                    <Button Grid.Column="2" Content="Get a token..." Command="{Binding GetDiscogsTokenCommand}" Padding="10,2" Margin="6,0,0,0"
                            ToolTip="Opens discogs.com > Settings > Developers" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Discogs asks programs to use a token for searching, and allows 60 lookups a minute with one instead of 25: sign in at discogs.com, open Settings > Developers, click Generate new token and paste it here." />
            </StackPanel>

            <!-- Updates -->
            <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
            <StackPanel Style="{StaticResource SectionBody}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="Check for _updates when CD-Tag starts" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Check _now" Command="{Binding CheckForUpdatesNowCommand}" Padding="10,2" Margin="6,0,0,0"
                            ToolTip="Looks for a newer CD-Tag on GitHub and asks whether to install it" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="{Binding CurrentVersionText}" />
            </StackPanel>

            <Path Data="M0,0 L1,0" Stroke="{DynamicResource Theme.Divider}" Stretch="Fill" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_OK" Command="{Binding OKCommand}" IsDefault="True" MinWidth="80" Padding="7,2" />
                <Button Content="_Cancel" IsCancel="True" MinWidth="80" Padding="7,2" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Views:WindowViewBase>
