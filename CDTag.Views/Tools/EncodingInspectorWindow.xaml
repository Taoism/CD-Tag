<Views:WindowViewBase
    x:Class="CDTag.Views.Tools.EncodingInspectorWindow"
    x:Name="encodingInspectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    Title="Encoding Inspector"
    Width="900"
    Height="640"
    MinWidth="620"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
>
    <Window.Resources>
        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Good">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Bad">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusBad}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Files -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="_Add..." Command="{Binding AddCommand}" MinWidth="70" Padding="7,2" />
                <Button Content="_Remove" Command="{Binding RemoveCommand}" MinWidth="70" Padding="7,2" Margin="6,0,0,0" />
                <Button Content="C_lear" Command="{Binding ClearCommand}" MinWidth="70" Padding="7,2" Margin="6,0,0,0" />
            </StackPanel>
            <DataGrid x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                      AllowDrop="True" DragOver="FileList_DragOver" Drop="FileList_Drop">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding FullPath}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- Details -->
        <DataGrid Grid.Column="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Binding="{Binding SectionLabel}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="170" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource ValueCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Close" Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True" MinWidth="80" Padding="7,2" />
        </StackPanel>
    </Grid>
</Views:WindowViewBase>
