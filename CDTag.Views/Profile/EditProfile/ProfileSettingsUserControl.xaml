<UserControl
    x:Class="CDTag.Views.Profile.EditProfile.ProfileSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,10,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ListBoxText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1: File naming -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=1}">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Album kind" Style="{StaticResource Label}" />
                    <ComboBox Grid.Column="1" Margin="0,2,0,8" ItemsSource="{Binding NamingSlots}" SelectedItem="{Binding SelectedSlot, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Text="Folder" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.Directory, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Audio files" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.AudioFile, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="CUE" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.CUE, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="Playlist (M3U)" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.Playlist, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="SFV/MD5" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.Checksum, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Text="NFO" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.NFO, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="7" Text="Images (JPG)" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.Images, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="8" Text="EAC log" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding NamingFormat.EACLog, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding TokenHint}" />

                <TextBlock Text="Options" FontWeight="Bold" Margin="0,10,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="File name limit" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Profile.FileNaming.FileCharacterLimit, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="3" Text="Folder name limit" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="4" Style="{StaticResource Field}" Text="{Binding Profile.FileNaming.DirectoryCharacterLimit, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <CheckBox Style="{StaticResource Check}" Content="Use underscores instead of spaces" IsChecked="{Binding Profile.FileNaming.UseUnderscores}" />
                <CheckBox Style="{StaticResource Check}" Content="Only allow characters A-Z a-z 0-9 - _ . ( )" IsChecked="{Binding Profile.FileNaming.UseStandardCharactersOnly}" />
                <CheckBox Style="{StaticResource Check}" Content="Convert regional characters to A-Z" IsChecked="{Binding Profile.FileNaming.UseLatinCharactersOnly}" />
                <CheckBox Style="{StaticResource Check}" Content="Smart case: don't change words in all caps" IsChecked="{Binding Profile.FileNaming.DontChangeCaseWordsWithAllCaps}" />
                <CheckBox Style="{StaticResource Check}" Content="Smart case: don't change words with non-letters" IsChecked="{Binding Profile.FileNaming.DontChangeCaseWordsWithNonLetter}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Naming rules -->
        <Grid Margin="4" Visibility="{Binding SelectedPage, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Replace (find =&gt; replace, one per line)" />
            <TextBox Grid.Row="1" Style="{StaticResource ListBoxText}" Text="{Binding ReplacementsText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Column="2" Text="Remove (one per line)" />
            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ListBoxText}" Text="{Binding RemoveStringsText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Row="2" Text="Lowercase words (smart case)" />
            <TextBox Grid.Row="3" Style="{StaticResource ListBoxText}" Text="{Binding LowercaseWordsText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Delete when finishing (wildcards, one per line)" />
            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource ListBoxText}" Text="{Binding DeleteFilesText, UpdateSourceTrigger=LostFocus}" />
        </Grid>

        <!-- 3: Release info -->
        <Grid Margin="4" Visibility="{Binding SelectedPage, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=3}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Ripper" Style="{StaticResource Label}" />
                <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.Ripper, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Column="2" Content="Lock" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ReleaseInfo.LockRipper}" />
                <TextBlock Grid.Column="4" Text="Supplier" Style="{StaticResource Label}" />
                <TextBox Grid.Column="5" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.Supplier, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Column="6" Content="Lock" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ReleaseInfo.LockSupplier}" />
                <TextBlock Grid.Row="1" Text="Encoder" Style="{StaticResource Label}" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.Encoder, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="1" Grid.Column="2" Content="Lock" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ReleaseInfo.LockEncoder}" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Comment" Style="{StaticResource Label}" />
                <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.Comment, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="1" Grid.Column="6" Content="Lock" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ReleaseInfo.LockComment}" />
                <TextBlock Grid.Row="2" Text="Ripping tool" Style="{StaticResource Label}" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.RippingTool, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Group initials" Style="{StaticResource Label}" />
                <TextBox Grid.Row="2" Grid.Column="5" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.GroupInitials, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,6,0,4"
                       Text="One per line. &quot;Text&quot; is used in both the NFO and the folder name; &quot;NFO text | folder text&quot; when they differ (&quot;Normal release |&quot; adds nothing to the folder)." />
            <TextBlock Grid.Row="2" Text="Type" />
            <TextBox Grid.Row="3" Style="{StaticResource ListBoxText}" Text="{Binding ReleaseTypesText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Source" />
            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource ListBoxText}" Text="{Binding SourcesText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Row="4" Text="Language" />
            <TextBox Grid.Row="5" Style="{StaticResource ListBoxText}" Text="{Binding LanguagesText, UpdateSourceTrigger=LostFocus}" />
        </Grid>

        <!-- 4: NFO -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=4}">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Template" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Profile.NFOOptions.TemplatePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="File name in the Profiles folder (or a full path)" />
                    <TextBlock Grid.Row="1" Text="Single CD header" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" AcceptsReturn="True" Text="{Binding Profile.NFOOptions.SingleCDHeader, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Multi-CD header" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" AcceptsReturn="True" Text="{Binding Profile.NFOOptions.MultiCDHeader, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. Disc #Disc/#Discs" />
                    <TextBlock Grid.Row="3" Text="Tracklist footer" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" AcceptsReturn="True" Text="{Binding Profile.NFOOptions.TracklistFooter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="Release notes header" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}" AcceptsReturn="True" Text="{Binding Profile.NFOOptions.ReleaseNotesHeader, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="Release notes footer" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}" AcceptsReturn="True" Text="{Binding Profile.NFOOptions.ReleaseNotesFooter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Text="Decimal character" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Width="40" HorizontalAlignment="Left" Style="{StaticResource Field}" Text="{Binding Profile.NFOOptions.DecimalCharacter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="7" Text="Date format" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Width="160" HorizontalAlignment="Left" Style="{StaticResource Field}" Text="{Binding ReleaseInfo.NfoDateFormat, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. yyyy-MM-dd" />
                </Grid>
                <CheckBox Style="{StaticResource Check}" Margin="0,8,0,3" Content="Show the release page (label, source, type...) when tagging" IsChecked="{Binding Profile.NFOOptions.ShowReleaseScreen}" />
                <CheckBox Style="{StaticResource Check}" Content="Use the average bitrate for VBR" IsChecked="{Binding Profile.NFOOptions.UseAverageBitrate}" />
                <CheckBox Style="{StaticResource Check}" Content="Preview the NFO automatically" IsChecked="{Binding Profile.NFOOptions.AutomaticallyPreviewNFO}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 5: Finish -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=5}">
            <StackPanel Margin="4">
                <TextBlock Text="When Finish is pressed in Tag Album" FontWeight="Bold" Margin="0,0,0,4" />
                <CheckBox Style="{StaticResource Check}" Content="Rename the folder" IsChecked="{Binding Profile.Finish.RenameDirectory}" />
                <CheckBox Style="{StaticResource Check}" Content="Rename the audio files" IsChecked="{Binding Profile.Finish.RenameAudioFiles}" />
                <CheckBox Style="{StaticResource Check}" Content="Rename CUE files" IsChecked="{Binding Profile.Finish.RenameCUEFiles}" />
                <CheckBox Style="{StaticResource Check}" Content="Rename images" IsChecked="{Binding Profile.Finish.RenameImageFiles}" />
                <CheckBox Style="{StaticResource Check}" Content="Rename EAC logs" IsChecked="{Binding Profile.Finish.RenameEACLogFiles}" />
                <CheckBox Style="{StaticResource Check}" Content="Create a playlist (M3U)" IsChecked="{Binding Profile.Finish.CreatePlaylist}" />
                <CheckBox Style="{StaticResource Check}" Content="Create an SFV" IsChecked="{Binding Profile.Finish.CreateSFV}" />
                <CheckBox Style="{StaticResource Check}" Content="Create an MD5" IsChecked="{Binding Profile.Finish.CreateMD5}" />
                <CheckBox Style="{StaticResource Check}" Content="Create a SHA1" IsChecked="{Binding Profile.Finish.CreateSHA1}" />
                <CheckBox Style="{StaticResource Check}" Content="Delete old files (the list on the Naming rules page)" IsChecked="{Binding Profile.Finish.DeleteOldFiles}" />
                <CheckBox Style="{StaticResource Check}" Content="Delete empty subfolders" IsChecked="{Binding Profile.Finish.DeleteEmptySubdirectories}" />
                <CheckBox Style="{StaticResource Check}" Content="Move files out of CD1, CD2... folders (101, 201...) and delete them" IsChecked="{Binding Profile.Finish.MoveOutOfDiscFolders}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="NFO" Style="{StaticResource Label}" />
                    <ComboBox Width="260" ItemsSource="{Binding FinishNFOChoices}" SelectedItem="{Binding Profile.Finish.NFO}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 6: Tagging -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=6}">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="MP3: ID3v2" Style="{StaticResource Label}" />
                    <ComboBox Grid.Column="1" Margin="0,2" ItemsSource="{Binding TagActions}" SelectedItem="{Binding Tagging.Id3v2}" />
                    <TextBlock Grid.Row="1" Text="MP3: ID3v1" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{Binding TagActions}" SelectedItem="{Binding Tagging.Id3v1}" />
                    <TextBlock Grid.Row="2" Text="FLAC: ID3v2" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{Binding TagActions}" SelectedItem="{Binding Tagging.FlacId3v2}" />
                    <TextBlock Grid.Row="3" Text="FLAC: ID3v1" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" ItemsSource="{Binding TagActions}" SelectedItem="{Binding Tagging.FlacId3v1}" />
                </Grid>
                <CheckBox Style="{StaticResource Check}" Margin="0,8,0,3" Content="Track numbers as n/total (and disc d/D)" IsChecked="{Binding Tagging.LongTrackNumbers}" />
                <CheckBox Style="{StaticResource Check}" Content="Don't write an ID3v2 comment" IsChecked="{Binding Tagging.NoId3v2Comment}" />
                <CheckBox Style="{StaticResource Check}" Content="Use the ID3v1 comment" IsChecked="{Binding Tagging.UseId3v1Comment}" />
                <CheckBox Style="{StaticResource Check}" Content="One playlist per disc" IsChecked="{Binding Tagging.SeparatePlaylistPerDisc}" />
                <CheckBox Style="{StaticResource Check}" Content="Embed the cover in FLAC files" IsChecked="{Binding Tagging.EmbedCoverInFlac}" />
                <CheckBox Style="{StaticResource Check}" Content="SFV/MD5: hide the &quot;generated by&quot; line" IsChecked="{Binding Tagging.ChecksumHideGeneratedBy}" />
                <CheckBox Style="{StaticResource Check}" Content="SFV/MD5: hide file sizes and dates" IsChecked="{Binding Tagging.ChecksumHideFileInfo}" />
                <CheckBox Style="{StaticResource Check}" Margin="0,8,0,3" Content="Don't check the scene rules when finishing" IsChecked="{Binding Tagging.SkipSceneRules}" Visibility="{Binding SceneTagging, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
