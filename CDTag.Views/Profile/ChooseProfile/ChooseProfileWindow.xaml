<Views:WindowViewBase
    x:Class="CDTag.Views.Profile.ChooseProfile.ChooseProfileWindow"
    x:Name="chooseProfileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    Title="Choose profile"
    Width="380"
    SizeToContent="Height"
    ResizeMode="NoResize"
    FocusManager.FocusedElement="{Binding ElementName=ProfileList}"
>
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <ListBox x:Name="ProfileList" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                 DisplayMemberPath="ProfileName" Height="140" MouseDoubleClick="ProfileList_MouseDoubleClick"
                 Background="{DynamicResource Theme.PaneBackground}" BorderBrush="{DynamicResource Theme.PaneBorder}" Foreground="{DynamicResource Theme.Foreground}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.RowHoverBackground}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.RowHoverBorder}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.RowSelectedBackground}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.RowSelectedBorder}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.RowSelectedForeground}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Path Data="M0,0 L1,0" Stroke="{DynamicResource Theme.Divider}" Stretch="Fill" Margin="0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_OK" Command="{Binding OKCommand}" IsDefault="True" MinWidth="80" Padding="7,2" />
            <Button Content="_Cancel" IsCancel="True" MinWidth="80" Padding="7,2" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Views:WindowViewBase>
