<view:ViewBase
    x:Class="CDTag.Views.Tag.TagToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:CDTag.Views"
    Focusable="False"
    IsTabStop="False"
>
    <!-- Tag/Rename toolbar, laid out like CD-Tag 2.x -->
    <Border Background="{DynamicResource Theme.ToolbarBackground}" BorderBrush="{DynamicResource Theme.ToolbarBorder}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="4,0">
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE72B;" Content="Back" Command="{Binding DirectoryViewModel.GoBackCommand}" ToolTip="Back (Alt+Left)" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE72A;" Content="Forward" Command="{Binding DirectoryViewModel.GoForwardCommand}" ToolTip="Forward (Alt+Right)" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE74A;" Content="Up" Command="{Binding DirectoryViewModel.GoUpCommand}" ToolTip="Up one level (Alt+Up)" />
            <Button x:Name="FavoritesButton" Style="{DynamicResource IconToolbarButton}" Tag="&#xE734;" Content="Favorites &#x25BE;" Click="FavoritesButton_Click" ToolTip="Favorite folders" />
            <Border Style="{DynamicResource ToolbarSeparator}" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE8C6;" Content="Split CUE" Command="{Binding SplitCueSheetCommand}" ToolTip="Split a CUE sheet (Ctrl+S)" />
            <Border Style="{DynamicResource ToolbarSeparator}" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE8EC;" Content="Show Tags" Command="{Binding EditTagsCommand}" ToolTip="Show and edit the tags of a file (Alt+3)" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE93C;" Content="Tag Album" Command="{Binding TagAlbumCommand}" ToolTip="Tag the selected album folder (Ctrl+T)" />
            <Border Style="{DynamicResource ToolbarSeparator}" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE9D5;" Content="SFV/MD5" Command="{Binding CreateChecksumCommand}" ToolTip="Create or verify checksums (Ctrl+K)" />
            <Border Style="{DynamicResource ToolbarSeparator}" />
            <Button Style="{DynamicResource IconToolbarButton}" Tag="&#xE897;" Content="Help" Command="{Binding ShowHelpCommand}" ToolTip="Help (F1)" />
        </StackPanel>
    </Border>
</view:ViewBase>
