<view:ViewBase
    x:Class="CDTag.Views.Tag.TagMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:CDTag.Views"
    xmlns:theming="clr-namespace:CDTag.Views.Theming"
>
    <!--
        Main menu. Like CD-Tag 2.x, the middle menus depend on the tab:
        Rip (tab 0): Rip   |   Convert Audio (tab 1): Encode   |   Tag/Rename (tab 2): View, Favorites, Tag
    -->
    <Grid>
        <Menu x:Name="Menu">
            <MenuItem Header="_File">
                <MenuItem Header="_New profile" Command="{Binding NewProfileCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Edit profile" Command="{Binding EditProfileCommand}" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="_Options" Command="{Binding OptionsCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="Copy to _folder..." Command="{Binding CopyToFolderCommand}" />
                <MenuItem Header="Mo_ve to folder..." Command="{Binding MoveToFolderCommand}" />
                <Separator />
                <MenuItem Header="Select _all" Command="{Binding Path=DirectoryViewModel.SelectAllCommand}" InputGestureText="Ctrl+A" />
                <MenuItem Header="_Invert selection" Command="{Binding Path=DirectoryViewModel.InvertSelectionCommand}" />
            </MenuItem>

            <!-- Rip tab -->
            <MenuItem x:Name="RipMenu" Header="_Rip" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=0}">
                <MenuItem Header="_Find CD" Command="{Binding FindCDCommand}" />
                <MenuItem Header="_Rip CD" Command="{Binding RipCDCommand}" />
                <Separator />
                <MenuItem Header="_Drive..." Command="{Binding DriveCommand}" />
                <MenuItem Header="_Options..." Command="{Binding OptionsCommand}" />
            </MenuItem>

            <!-- Convert Audio tab -->
            <MenuItem x:Name="EncodeMenu" Header="E_ncode" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=1}">
                <MenuItem Header="_Add files..." Command="{Binding AddCommand}" />
                <MenuItem Header="_Remove" Command="{Binding RemoveCommand}" />
                <MenuItem Header="_Clear" Command="{Binding ClearCommand}" />
                <Separator />
                <MenuItem Header="Move _up" Command="{Binding MoveUpCommand}" />
                <MenuItem Header="Move _down" Command="{Binding MoveDownCommand}" />
                <Separator />
                <MenuItem Header="_Encode" Command="{Binding EncodeCommand}" />
                <MenuItem Header="De_code" Command="{Binding DecodeCommand}" />
                <Separator />
                <MenuItem Header="_Options..." Command="{Binding OptionsCommand}" />
            </MenuItem>

            <!-- Tag/Rename tab -->
            <MenuItem Header="_View" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=2}">
                <MenuItem Header="Status _bar" IsCheckable="True" IsChecked="{Binding IsShowStatusBarChecked, Mode=TwoWay}" />
                <MenuItem Header="_Navigation pane" IsCheckable="True" IsChecked="{Binding IsShowNavigationPaneChecked, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="_Theme">
                    <MenuItem Header="Use _Windows setting" Command="{Binding SetThemeCommand, Source={x:Static theming:ThemeManager.Instance}}" CommandParameter="System" IsChecked="{Binding IsSystem, Source={x:Static theming:ThemeManager.Instance}, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="_Light" Command="{Binding SetThemeCommand, Source={x:Static theming:ThemeManager.Instance}}" CommandParameter="Light" IsChecked="{Binding IsLight, Source={x:Static theming:ThemeManager.Instance}, Mode=OneWay}" />
                    <MenuItem Header="_Dark" Command="{Binding SetThemeCommand, Source={x:Static theming:ThemeManager.Instance}}" CommandParameter="Dark" IsChecked="{Binding IsDark, Source={x:Static theming:ThemeManager.Instance}, Mode=OneWay}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem x:Name="FavoritesMenuItem" Header="F_avorites" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=2}">
                <!-- Filled when opened (FavoritesMenu.Fill); the placeholder makes it a submenu. -->
                <MenuItem Header="(empty)" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Tag" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=2}">
                <MenuItem Header="Tag _album" Command="{Binding TagAlbumCommand}" InputGestureText="Ctrl+T" />
                <MenuItem Header="_Show tags" Command="{Binding EditTagsCommand}" InputGestureText="Alt+3" />
                <MenuItem Header="_Mass tag" Command="{Binding MassTagCommand}" InputGestureText="Ctrl+M" />
                <Separator />
                <MenuItem Header="_Split CUE sheet" Command="{Binding SplitCueSheetCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Encoding _inspector" Command="{Binding EncodingInspectorCommand}" InputGestureText="Ctrl+I" />
                <Separator />
                <MenuItem Header="_Create checksum (SFV/MD5)" Command="{Binding CreateChecksumCommand}" InputGestureText="Ctrl+K" />
                <MenuItem Header="_Verify checksum" Command="{Binding VerifyChecksumCommand}" InputGestureText="Ctrl+L" />
                <MenuItem Header="Verify _EAC log file" Command="{Binding VerifyEACLogCommand}" InputGestureText="Ctrl+E" />
            </MenuItem>

            <MenuItem Header="_Window">
                <MenuItem Header="_Rip" Command="{Binding ShowRipCommand}" InputGestureText="Ctrl+1" />
                <MenuItem Header="_Convert Audio" Command="{Binding ShowConvertAudioCommand}" InputGestureText="Ctrl+2" />
                <MenuItem Header="_Tag/Rename" Command="{Binding ShowTagRenameCommand}" InputGestureText="Ctrl+3" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help" Command="{Binding ShowHelpCommand}" InputGestureText="F1" />
                <Separator />
                <MenuItem Header="Home _page" Command="{Binding HomePageCommand}" />
                <MenuItem Header="Report a _problem" Command="{Binding SupportForumCommand}" />
                <Separator />
                <MenuItem Header="_About CD-Tag" Command="{Binding AboutCommand}" InputGestureText="Ctrl+F1" />
            </MenuItem>
        </Menu>
    </Grid>
</view:ViewBase>
