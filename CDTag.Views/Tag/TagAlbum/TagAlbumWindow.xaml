<Views:WindowViewBase
    x:Class="CDTag.Views.Tag.TagAlbum.TagAlbumWindow"
    x:Name="tagAlbumWindow2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    xmlns:Converters="clr-namespace:CDTag.Converters"
    Title="{Binding Album.OldDirectoryName, Mode=OneWay, StringFormat='Tagging {0}', FallbackValue='Tag Album'}"
    Height="640"
    Width="760"
    MinWidth="640"
    MinHeight="500"
>
    <Views:WindowViewBase.Resources>
        <!-- Right-click on a song name (CD-Tag 2.x) -->
        <ContextMenu x:Key="SongNameMenu" x:Shared="False" Opened="SongNameMenu_Opened">
            <MenuItem Header="_Undo" Tag="UndoTitles" Click="UndoTitles_Click" />
            <Separator />
            <MenuItem Header="_Casing">
                <MenuItem Header="Capitalize Every Word" Tag="CapitalizeEveryWord" Click="Casing_Click" />
                <MenuItem Header="UPPERCASE" Tag="Uppercase" Click="Casing_Click" />
                <MenuItem Header="lowercase" Tag="Lowercase" Click="Casing_Click" />
                <MenuItem Header="Sentence case" Tag="SentenceCase" Click="Casing_Click" />
            </MenuItem>
            <MenuItem Header="_Search &amp; Replace..." Click="SearchReplace_Click" />
            <Separator />
            <MenuItem Header="_Paste Tracklist" Click="PasteTracklist_Click" />
            <Separator />
            <MenuItem Command="ApplicationCommands.Cut" />
            <MenuItem Command="ApplicationCommands.Copy" />
            <MenuItem Command="ApplicationCommands.Paste" />
        </ContextMenu>
        <Converters:ShortFileNameConverter x:Key="ShortFileNameConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <DataTemplate x:Key="ListItemTemplate">
            <TextBlock Text="{Binding Nfo}" />
        </DataTemplate>
    </Views:WindowViewBase.Resources>

    <Grid x:Name="LayoutRoot" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Page 0: release information (NFO fields) ============ -->
        <Grid x:Name="ReleasePage" Grid.Row="0" Visibility="{Binding Page, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Record label" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.Label, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Text="Rip date" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.RipDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-dd" />
                <TextBlock Grid.Row="2" Text="Retail date" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.RetailDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-dd (use 00 for unknown month/day)" />
                <TextBlock Grid.Row="3" Text="Comment" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.Comment, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCommentLocked}" />
                <TextBlock Grid.Row="4" Text="URL" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.Url, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="5" Text="OST" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Width="70" HorizontalAlignment="Left" SelectedIndex="{Binding OstIndex}">
                    <ComboBoxItem Content="No" />
                    <ComboBoxItem Content="Yes" />
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Source" Style="{StaticResource FieldLabel}" />
                <Grid Grid.Row="0" Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Margin="0,2" VerticalAlignment="Center" ItemsSource="{Binding Sources}" SelectedItem="{Binding Release.Source}" ItemTemplate="{StaticResource ListItemTemplate}" />
                    <TextBlock Grid.Column="1" Text="Bit/kHz" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" IsEnabled="{Binding HasBitKhz}" Visibility="{Binding SceneTagging, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Grid.Column="2" Width="130" Margin="0,2" VerticalAlignment="Center" Visibility="{Binding SceneTagging, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding QualityChoices}" DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding Release.Quality}" IsEnabled="{Binding HasBitKhz}" ToolTipService.ShowOnDisabled="True"
                              ToolTip="WEB-FLAC and Blu-ray only. WEB-FLAC (rules 4.10): read from the files (16BIT, or 24BIT-96KHZ); goes before the source in the release name (-16BIT-WEB-FLAC-, -24BIT-96KHZ-BLURAY-FLAC-). Finish checks it against the files." />
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Type" Style="{StaticResource FieldLabel}" />
                <Grid Grid.Row="1" Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Margin="0,2" VerticalAlignment="Center" ItemsSource="{Binding ReleaseTypes}" SelectedItem="{Binding Release.ReleaseType}" ItemTemplate="{StaticResource ListItemTemplate}" />
                    <TextBlock Grid.Column="1" Text="Fix" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" Visibility="{Binding SceneTagging, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Grid.Column="2" Width="130" Margin="0,2" VerticalAlignment="Center" Visibility="{Binding SceneTagging, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding FixChoices}" DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding Release.Fix}"
                              ToolTip="Goes before the source in the release name (-REPACK-16BIT-WEB-FLAC-, -DIRFIX-2CD-). FLAC REPACKs also get -repack at the end of each .flac file (FLAC rules 5.6). The NFO must name the release being fixed (rules 4.6.1); #Fix in an NFO template prints it." />
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Language" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="2" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" ItemsSource="{Binding Languages}" SelectedItem="{Binding Release.Language}" ItemTemplate="{StaticResource ListItemTemplate}" />
                <TextBlock Grid.Row="3" Grid.Column="3" Text="Catalog #" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.CatalogNumber, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="3" Text="Live date" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.LiveDate, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="5" Grid.Column="3" Text="Internal" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="5" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Width="70" HorizontalAlignment="Left" SelectedIndex="{Binding InternalIndex}">
                    <ComboBoxItem Content="No" />
                    <ComboBoxItem Content="Yes" />
                </ComboBox>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,10,0,6" MinHeight="120">
                <TabItem Header="NFO Notes">
                    <TextBox Text="{Binding Release.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                </TabItem>
                <TabItem Header="Long Comment">
                    <TextBox Text="{Binding Release.LongComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                </TabItem>
                <TabItem Header="Track Preview">
                    <DataGrid ItemsSource="{Binding TrackPreview}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" CanUserAddRows="False" CanUserSortColumns="False" BorderThickness="0"
                              AlternatingRowBackground="{DynamicResource Theme.RowAlternateBackground}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Disc" Binding="{Binding Disc}" Width="44" />
                            <DataGridTextColumn Header="#" Binding="{Binding Track}" Width="38" />
                            <DataGridTextColumn x:Name="PreviewArtistColumn" Header="Artist" Binding="{Binding Artist}" Width="*" />
                            <DataGridTextColumn Header="Song name" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="56" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Ripper" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.Ripper, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRipperLocked}" />
                <TextBlock Grid.Row="1" Text="Supplier" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.Supplier, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSupplierLocked}" />
                <TextBlock Grid.Row="2" Text="Encoder" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" IsEditable="True" ItemsSource="{Binding Encoders}" Text="{Binding Release.Encoder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEncoderLocked, Converter={StaticResource NegateBoolConverter}}" />
                <TextBlock Grid.Row="3" Text="Ripping tool" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" IsEditable="True" ItemsSource="{Binding RippingTools}" Text="{Binding Release.RippingTool, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Clean/explicit" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="0" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Width="140" HorizontalAlignment="Left" ItemsSource="{Binding CleanExplicitChoices}" SelectedItem="{Binding Release.CleanExplicit}" ItemTemplate="{StaticResource ListItemTemplate}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Limited edition" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Width="70" HorizontalAlignment="Left" ItemsSource="{Binding LimitedEditionChoices}" SelectedItem="{Binding Release.LimitedEdition}" ItemTemplate="{StaticResource ListItemTemplate}" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="White label" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="2" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Width="70" HorizontalAlignment="Left" ItemsSource="{Binding WhiteLabelChoices}" SelectedItem="{Binding Release.WhiteLabel}" ItemTemplate="{StaticResource ListItemTemplate}" />
            </Grid>
        </Grid>

        <!-- ============ Page 1: album and tracks ============ -->
        <Grid x:Name="AlbumPage" Grid.Row="0" Visibility="{Binding Page, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=1}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="New folder" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,2" VerticalAlignment="Center" IsReadOnly="True" Text="{Binding Album.NewFolderName, Mode=OneWay}"
                         ToolTip="{Binding OldFolderName, StringFormat='Currently: {0}'}" />
                <TextBlock Grid.Row="1" Text="Artist" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Album.Artist, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="Album" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" VerticalAlignment="Center" Text="{Binding Album.AlbumTitle, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Various artists" Margin="0,4" IsChecked="{Binding Album.IsVariousArtists}" />

                <TextBlock Grid.Row="1" Grid.Column="3" Text="Retail date" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" Text="{Binding Release.RetailDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-dd (use 00 for unknown month/day)" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Genre" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="2" Grid.Column="4" Margin="0,2" VerticalAlignment="Center" IsEditable="True" ItemsSource="{Binding Genres}" Text="{Binding Album.Genre, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Show all genres" IsChecked="{Binding ShowAllGenres}" Margin="0,4,16,4" />
                </StackPanel>

                <!-- Cover -->
                <Border Grid.Row="0" Grid.Column="5" Grid.RowSpan="4" Width="100" Height="100" Margin="12,0,0,0" VerticalAlignment="Top"
                        BorderThickness="1" BorderBrush="{DynamicResource Theme.PaneBorder}" Background="{DynamicResource Theme.PaneBackground}">
                    <Image Source="{Binding Album.Picture}" Stretch="Uniform" />
                </Border>

                <TextBlock Grid.Row="5" Text="Old file name" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,2" VerticalAlignment="Center" IsReadOnly="True" Text="{Binding SelectedTrack.OriginalFileName, Mode=OneWay, Converter={StaticResource ShortFileNameConverter}}" />
                <TextBlock Grid.Row="6" Text="New file name" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,2" VerticalAlignment="Center" IsReadOnly="True" Text="{Binding SelectedTrack.NewFileName, Mode=OneWay}" />
                <TextBlock Grid.Row="7" Text="{Binding DiscNameLabel}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,2" VerticalAlignment="Center" Text="{Binding DiscName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Name of the selected track's disc: shown in the NFO disc header (Disc 1/14 - name) and written as the disc subtitle tag" />
            </Grid>

            <DataGrid x:Name="TracksDataGrid" Grid.Row="1" Margin="0,8,0,0"
                      ItemsSource="{Binding Album.Tracks, Mode=OneWay}" AutoGenerateColumns="False"
                      CanUserSortColumns="False" CanUserDeleteRows="False" CanUserAddRows="False"
                      SelectedIndex="{Binding SelectedTrackIndex, Mode=TwoWay}" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      AlternatingRowBackground="{DynamicResource Theme.RowAlternateBackground}" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Track" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Disc" Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="ArtistColumn" Header="Artist" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Song name" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" ContextMenu="{StaticResource SongNameMenu}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ============ Buttons ============ -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Preview _NFO" Command="{Binding PreviewNFOCommand}" Padding="10,3" />
                <Button Content="_Look up" Command="{Binding LookupCommand}" Padding="10,3" Margin="8,0,0,0"
                        ToolTip="Look up this album (MusicBrainz, CUETools DB: track titles, date, label, catalog #, cover)" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource Theme.ForegroundSecondary}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Profile.ProfileName, Mode=OneWay, StringFormat='Profile: {0}', FallbackValue='Profile: (none)', TargetNullValue='Profile: (none)'}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFinishing}" Value="True">
                                <Setter Property="Text" Value="{Binding FinishStatus}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="2" Content="_Previous" Command="{Binding PreviousCommand}" MinWidth="86" Padding="10,3" Margin="8,0,0,0" />
            <Grid Grid.Column="3" Margin="8,0,0,0">
                <Button Content="_Next" Command="{Binding NextCommand}" MinWidth="86" Padding="10,3" IsDefault="True"
                        Visibility="{Binding Page, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=0}" />
                <Button Content="_Finish" Command="{Binding FinishCommand}" MinWidth="86" Padding="10,3"
                        ToolTip="Write the tags and cover, rename the files and folder, create the NFO, playlist and checksum files"
                        Visibility="{Binding Page, Converter={StaticResource IsEqualToVisibilityConverter}, ConverterParameter=1}" />
            </Grid>
        </Grid>
    </Grid>
</Views:WindowViewBase>
