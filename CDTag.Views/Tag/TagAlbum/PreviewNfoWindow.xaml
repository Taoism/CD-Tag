<Views:WindowViewBase
    x:Class="CDTag.Views.Tag.TagAlbum.PreviewNfoWindow"
    x:Name="previewNfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    Title="{Binding FileName, Mode=OneWay, StringFormat='Preview NFO - {0}', FallbackValue='Preview NFO', TargetNullValue='Preview NFO'}"
    Width="700"
    Height="720"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- NFO art: Consolas has the CP437 block characters; line height = font size so blocks join. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource Theme.PaneBackground}" BorderThickness="0">
            <TextBlock Text="{Binding Text, Mode=OneWay}" Margin="12,8"
                       FontFamily="Consolas" FontSize="13" LineStackingStrategy="BlockLineHeight" LineHeight="13"
                       Foreground="{DynamicResource Theme.Foreground}" TextOptions.TextFormattingMode="Display" />
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Theme.Divider}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
                <Button Content="_Copy" MinWidth="80" Padding="7,2" Click="Copy_Click" />
                <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="80" Padding="7,2" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Views:WindowViewBase>
