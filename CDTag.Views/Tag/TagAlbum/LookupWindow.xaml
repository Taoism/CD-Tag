<Views:WindowViewBase
    x:Class="CDTag.Views.Tag.TagAlbum.LookupWindow"
    x:Name="lookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CDTag.Views"
    Title="Look up album (MusicBrainz)"
    Width="900"
    Height="640"
    MinWidth="640"
    MinHeight="420"
>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Artist" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="2" />
            <TextBlock Grid.Column="2" Text="Album" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox Grid.Column="3" Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="2" />
            <Button Grid.Column="4" Content="_Search" Command="{Binding SearchCommand}" IsDefault="True" MinWidth="86" Padding="10,3" Margin="12,0,0,0" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="or release link" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Theme.ForegroundSecondary}" />
            <TextBox Grid.Column="1" Text="{Binding ReleaseLink, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="2"
                     ToolTip="Paste a musicbrainz.org/release/... link or release ID, then press Search" />
        </Grid>

        <!-- Results -->
        <DataGrid Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MatchesTrackCount}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.6*" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="82" />
                <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="56" />
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="90" />
                <DataGridTextColumn Header="Tracks" Binding="{Binding TrackCount}" Width="52" />
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Cat #" Binding="{Binding CatalogNumber}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,8,0,4" Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

        <!-- Track list of the selected release -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="None" CanUserAddRows="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Disc" Binding="{Binding Disc}" Width="44" />
                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="38" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status / buttons -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.ForegroundSecondary}" />
            <Button Grid.Column="1" Content="_Apply" Command="{Binding ApplyCommand}" MinWidth="86" Padding="10,3" Margin="8,0,0,0"
                    ToolTip="Fill artist, album, date, label, catalog #, track titles and cover from this release" />
            <Button Grid.Column="2" Content="Cancel" IsCancel="True" MinWidth="86" Padding="10,3" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Views:WindowViewBase>
