<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CDTag.Controls;assembly=CDTag.Controls"
>
    <!--
        Error banner shown at the top of a window (ErrorContainer) when an exception reaches
        App.DispatcherUnhandledException / IDialogService.ShowError.

        Named parts and visual states (Hidden / Shown / ShowDetails) are required by
        CDTag.Controls.ErrorNotification. This style used to live in CDTag/Themes/Generic.xaml,
        where WPF never found it (generic.xaml is only probed in the control's own assembly),
        so the banner rendered as nothing and errors were silently swallowed.
    -->

    <Style x:Key="NotificationRoundButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.NotificationButton}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Circle" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.7" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.NotificationButtonHover}" />
                            <Setter TargetName="Circle" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Controls:ErrorNotification}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ErrorNotification}">
                    <Grid x:Name="LayoutRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisibilityStates">
                                <VisualState x:Name="Hidden" />
                                <VisualState x:Name="Shown">
                                    <Storyboard>
                                        <DoubleAnimation To="30" Duration="0:0:0.3" Storyboard.TargetName="NotificationContainer" Storyboard.TargetProperty="Height">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation To="0" Duration="0:0:0.3" Storyboard.TargetName="ShowDetailsButtonCompositeTransform" Storyboard.TargetProperty="Angle" />
                                        <DoubleAnimation To="0" Duration="0:0:0.3" Storyboard.TargetName="DetailsTextBox" Storyboard.TargetProperty="Height" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ShowDetails">
                                    <Storyboard>
                                        <DoubleAnimation To="146" Duration="0:0:0.3" Storyboard.TargetName="NotificationContainer" Storyboard.TargetProperty="Height">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation To="-180" Duration="0:0:0.3" Storyboard.TargetName="ShowDetailsButtonCompositeTransform" Storyboard.TargetProperty="Angle" />
                                        <DoubleAnimation To="100" Duration="0:0:0.3" Storyboard.TargetName="DetailsTextBox" Storyboard.TargetProperty="Height" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="NotificationContainer" Height="0" ClipToBounds="True" BorderThickness="0,0,0,1"
                                Background="{DynamicResource Theme.NotificationBackground}" BorderBrush="{DynamicResource Theme.NotificationBorder}"
                                TextElement.Foreground="{DynamicResource Theme.NotificationForeground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="29" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="MessageTextBlock" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           TextWrapping="NoWrap" TextTrimming="WordEllipsis" Text="An error has occurred." />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ShowDetailsButton" Margin="0,0,8,0" Style="{StaticResource NotificationRoundButton}" RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform>
                                            <RotateTransform x:Name="ShowDetailsButtonCompositeTransform" />
                                        </Button.RenderTransform>
                                        <Button.ToolTip>
                                            <TextBlock x:Name="ShowDetailsButtonToolTip" Text="Show details" />
                                        </Button.ToolTip>
                                        <Path Data="M 0,0 L 7,0 L 3.5,4.5 Z" Margin="0,1,0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button x:Name="CloseButton" Margin="0,0,8,0" Style="{StaticResource NotificationRoundButton}" ToolTip="Close">
                                        <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>

                                <TextBox x:Name="DetailsTextBox" Grid.Row="1" Grid.ColumnSpan="2" Height="0" Margin="8,0,8,8"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas" FontSize="11"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
