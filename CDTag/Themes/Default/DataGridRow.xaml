<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>

    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.RowHoverBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.RowHoverBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.RowSelectedForeground}" />
                <Setter Property="Background" Value="{DynamicResource Theme.RowSelectedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.RowSelectedBorder}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
                <Setter Property="Background" Value="{DynamicResource Theme.RowSelectedInactiveBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.RowSelectedInactiveBorder}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
