<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>cdtag</AssemblyName>
    <ApplicationIcon>cdtag.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="cdtag.ico" />
    <Resource Include="Resources\Images\GeneralToolbar\Help.png" />
    <Resource Include="Resources\Images\TagToolbar\Back.png" />
    <Resource Include="Resources\Images\TagToolbar\Forward.png" />
    <Resource Include="Resources\Images\TagToolbar\TagAlbum.png" />
    <Resource Include="Resources\Images\TagToolbar\Up.png" />
    <Resource Include="Resources\Images\About\cdtag.png" />
    <Resource Include="Resources\Images\GeneralToolbar\Settings_24.png" />
    <Resource Include="Resources\Images\GeneralToolbar\Settings2_24.png" />
    <Resource Include="Resources\Images\GeneralToolbar\Tools_24.png" />
    <Resource Include="Resources\Images\GeneralToolbar\Settings_16.png" />
    <Resource Include="Resources\Images\GeneralToolbar\wrench_16.png" />
    <Resource Include="Resources\Images\GeneralToolbar\wrench_plus_2_16.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Languages\english.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Defaults\blank.nfo" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Encoders\**\*.exe;..\Encoders\**\*.dll;..\Encoders\**\*.txt" Condition="Exists('..\Encoders') And '$(Configuration)' != 'Release'" Link="Encoders\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release (GitHub) build: one cdtag.exe (all DLLs inside), everything else in bin\. Needs the .NET 10 Desktop Runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Release layout: CD-Tag and its files in bin\, and the starter (Launcher, .NET Framework 4.8) as cdtag.exe on top;
       the starter installs the .NET 10 Desktop Runtime when it is missing. -->
  <Target Name="MoveToBinAndAddLauncher" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_OldAppConfig Include="$(PublishDir)cdtag.dll.config;$(PublishDir)cdtag.exe.config" />
      <_ToBin Include="$(PublishDir)**\*" Exclude="$(PublishDir)bin\**;@(_OldAppConfig)" />
    </ItemGroup>
    <Delete Files="@(_OldAppConfig)" />
    <Move SourceFiles="@(_ToBin)" DestinationFiles="@(_ToBin->'$(PublishDir)bin\%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(PublishDir)Languages;$(PublishDir)Defaults" />
    <MSBuild Projects="..\Launcher\CDTag.Launcher.csproj" Targets="Restore;Build" Properties="Configuration=Release" />
    <Copy SourceFiles="..\Launcher\bin\Release\net48\cdtag.exe" DestinationFolder="$(PublishDir)" />
    <!-- options.json next to cdtag.exe: CD-Tag reads and saves its options there ("enabled": "false" = no scene-style tagging). -->
    <Copy SourceFiles="Defaults\options.json" DestinationFolder="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\External\IdSharp\IdSharp.AudioInfo\IdSharp.AudioInfo.csproj" />
    <ProjectReference Include="..\External\IdSharp\IdSharp.Common\IdSharp.Common.csproj" />
    <ProjectReference Include="..\External\IdSharp\IdSharp.Tagging\IdSharp.Tagging.csproj" />
    <ProjectReference Include="..\CDTag.Common\CDTag.Common.csproj" />
    <ProjectReference Include="..\CDTag.Controls\CDTag.Controls.csproj" />
    <ProjectReference Include="..\CDTag.FileBrowser\CDTag.FileBrowser.csproj" />
    <ProjectReference Include="..\CDTag.Models\CDTag.Models.csproj" />
    <ProjectReference Include="..\CDTag.Views.Interfaces\CDTag.Views.Interfaces.csproj" />
    <ProjectReference Include="..\CDTag.ViewModels\CDTag.ViewModels.csproj" />
    <ProjectReference Include="..\CDTag.Views\CDTag.Views.csproj" />
  </ItemGroup>

</Project>
